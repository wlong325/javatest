 350   2              if(KEY_Task < KEY_TASK_TIME) KEY_Task++;
 351   2      
 352   2              if(tx_led_on)
 353   2              {
 354   3                  if(TX_LED_Task < LED_BLINK_TIME) TX_LED_Task++;
 355   3                  else
 356   3                  {
 357   4                      TX_LED_Task = 0;
 358   4                      tx_led_on = 0;
 359   4                  }
 360   3              }
 361   2          }
 362   1      
 363   1          if(CCF2)                 // 显示刷新
 364   1          {
C51 COMPILER V9.56.0.0   MAIN                                                              10/26/2026 16:57:00 PAGE 7   

 365   2              CCF2 = 0;
 366   2              CCAP2L = TIME_2;
