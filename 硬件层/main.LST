 174   1          unsigned long weight = 10000000;
 175   1      
 176   1          for(i=0;i<8;i++)
 177   1          {
 178   2              d = (unsigned char)(num / weight);
C51 COMPILER V9.56.0.0   MAIN                                                              10/26/2026 16:57:00 PAGE 4   

 179   2              num %= weight;
 180   2              weight /= 10;
 181   2              if(show == 0 && d == 0 && i < 7) seg[i] = SEG_BLANK;
 182   2              else
 183   2              {
 184   3                  show = 1;
 185   3                  seg[i] = d;
 186   3              }
 187   2          }
 188   1      }
