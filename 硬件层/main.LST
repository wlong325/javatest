 147          void Display_Clear(void)
 148          {
 149   1          unsigned char i;
 150   1          for(i=0;i<8;i++) seg[i] = SEG_BLANK;
 151   1      }
 152          
 153          /********************************* 数码管显示 *********************************
 154           * 显示内容：上传成功次数 upload_count。
 155           * 前导零不显示；全为 0 时显示单个 0；每帧刷新（无需保存）。
 156           ******************************************************************************/
 157          void Display_Proc(void)
 158          {
 159   1          unsigned char i;
 160   1          unsigned char d;
 161   1          unsigned char show = 0;
 162   1          unsigned long num = upload_count;
 163   1          unsigned long weight = 10000000;
 164   1      
 165   1          for(i=0;i<8;i++)
 166   1          {
 167   2              d = (unsigned char)(num / weight);
 168   2              num %= weight;
 169   2              weight /= 10;
 170   2              if(show == 0 && d == 0 && i < 7) seg[i] = SEG_BLANK;
 171   2              else
 172   2              {
 173   3                  show = 1;
 174   3                  seg[i] = d;
 175   3              }
 176   2          }
 177   1      }
 178          
C51 COMPILER V9.56.0.0   MAIN                                                              10/25/2026 21:51:13 PAGE 4   

 179          /********************************* 任务调度 ***********************************
 180           * 各传感器按周期采集；
 181           * 每 SEND_TASK_TIME 拼一帧发到串口；
 182           * 发送完成后计数 +1 并点亮 L1。
 183           ******************************************************************************/
 184          void Task_Proc(void)
 185          {
 186   1          unsigned int raw_temp;
 187   1          unsigned char tx_i;
 188   1      
 189   1          if(PCF8591_Task >= PCF8591_TASK_TIME)
 190   1          {
 191   2              PCF8591_Task = 0;
 192   2              PCF8591_Adc(adc);
 193   2              pot_mv = (unsigned int)((unsigned long)adc[3] * 5000 / 255);
 194   2              light_mv = (unsigned int)((unsigned long)adc[1] * 5000 / 255);
 195   2          }
 196   1      
 197   1          if(DS18B20_Task >= DS18B20_TASK_TIME)
 198   1          {
 199   2              DS18B20_Task = 0;
 200   2              raw_temp = rd_temperature();
 201   2              ds18b20 = DS18B20_ToIntC(raw_temp);
 202   2          }
 203   1      
 204   1          if(NE555_Task >= NE555_TASK_TIME)
 205   1          {
 206   2              NE555_Task = 0;
 207   2              TR0 = 0;
 208   2              ne555 = ((unsigned int)TH0 << 8) | TL0;
 209   2              TH0 = 0;
 210   2              TL0 = 0;
 211   2              TR0 = 1;
 212   2          }
 213   1      
 214   1          if(Send_Task >= SEND_TASK_TIME)
 215   1          {
 216   2              tx_i = 0;
 217   2              Send_Task = 0;
 218   2              if(B_TX1_busy != 255) return;
 219   2      
 220   2              Uart_TxClear();
 221   2              Uart_TxPutChar(&tx_i,'S');
 222   2              Uart_TxPutChar(&tx_i,',');
 223   2              if(ds18b20 < 0)
 224   2              {
 225   3                  Uart_TxPutChar(&tx_i,'-');
 226   3                  Uart_TxPutUInt(&tx_i,(unsigned int)(-ds18b20));
 227   3              }
 228   2              else
 229   2              {
 230   3                  Uart_TxPutUInt(&tx_i,(unsigned int)ds18b20);
 231   3              }
 232   2              Uart_TxPutChar(&tx_i,',');
 233   2              Uart_TxPutUInt(&tx_i,light_mv);
 234   2              Uart_TxPutChar(&tx_i,',');
 235   2              Uart_TxPutUInt(&tx_i,pot_mv);
 236   2              Uart_TxPutChar(&tx_i,',');
 237   2              Uart_TxPutUInt(&tx_i,ne555);
 238   2              Uart_TxPutString(&tx_i,"\r\n");
 239   2              Uart_TxStart();
 240   2              tx_ok_flag = 1;
C51 COMPILER V9.56.0.0   MAIN                                                              10/25/2026 21:51:13 PAGE 5   

 241   2          }
 242   1      
 243   1          /* 发送完成：帧已全部发出 → 计数 +1，L1 亮起 */
 244   1          if(tx_ok_flag && B_TX1_busy == 255)
 245   1          {
 246   2              tx_ok_flag = 0;
 247   2              upload_count++;
 248   2              tx_led_on = 1;
 249   2              TX_LED_Task = 0;
 250   2          }
 251   1      }
 252          
 253          /********************************* LED 处理 ***********************************/
 254          void Led_Proc(void)
 255          {
 256   1          led = 0x00;
 257   1          if(tx_led_on) led |= 0x01;   // L1：发送成功后亮 0.2 秒
 258   1      }
