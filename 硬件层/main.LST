 163          void HC573_Write(unsigned char channel,unsigned char dat)
 164          {
 165   1          P2 &= 0x1f;
 166   1          P0 = dat;
 167   1          switch(channel)
 168   1          {
 169   2              case 4: P2 = (P2 & 0x1f) | 0x80; break;
 170   2              case 5: P2 = (P2 & 0x1f) | 0xa0; break;
 171   2              case 6: P2 = (P2 & 0x1f) | 0xc0; break;
 172   2              case 7: P2 = (P2 & 0x1f) | 0xe0; break;
 173   2              default: break;
 174   2          }
 175   1          P2 &= 0x1f;
 176   1      }
