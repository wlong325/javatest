 412          void Key_Proc(void)
 413          {
 414   1          if(KEY_Task < KEY_TASK_TIME) return;
 415   1          KEY_Task = 0;
 416   1      
 417   1          key_val = Key_Read();
 418   1          key_down = key_val & (key_val ^ key_old);
 419   1          key_old = key_val;
 420   1      
 421   1          if(key_down == 4)          /* S4：界面 1~5 循环切换 */
 422   1          {
 423   2              mode++;
 424   2              if(mode > 4) mode = 0;
 425   2              disp_dirty = 1;
 426   2          }
