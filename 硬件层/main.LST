 603          /********************************* 串口接收处理 ********************************
 604           * 双向控制：命令帧由桥通过串口下发，10ms 空闲判帧结束，主循环解析执行。
 605           * 命令表：? → OK；R1/R0 → 继电器开/关；B1/B0 → 蜂鸣器开/关。
 606           * 执行后回 OK；命令不识别回 ERROR。继电器/蜂鸣器改影子变量 b_and_r，
 607           * 由 CCF2 中断统一写入 74HC573 通道 5（bit4=继电器，bit6=蜂鸣器）。
 608           ******************************************************************************/
 609          void Uart_ClearRxBuffer(void)
 610          {
 611   1          unsigned char i;
C51 COMPILER V9.56.0.0   MAIN                                                              10/30/2026 20:47:17 PAGE 11  

 612   1          for(i=0;i<RX1_LENGTH;i++) RX1_Buffer[i] = 0;
 613   1          B_RX1_Con = 0;
 614   1          UART_Idle_Task = 0;
 615   1          B_RX1_flag = 0;
 616   1      }
 617          
 618          void Uart_Proc(void)
 619          {
 620   1          unsigned char rx_len;
 621   1          unsigned char frame_state;
 622   1      
 623   1          frame_state = B_RX1_flag;
 624   1          if(frame_state == 0) return;
 625   1      
 626   1          rx_len = B_RX1_Con;
 627   1          while(rx_len > 0 && (RX1_Buffer[rx_len-1] == '\r' || RX1_Buffer[rx_len-1] == '\n'))
 628   1          {
 629   2              rx_len--;
 630   2          }
 631   1          RX1_Buffer[rx_len] = '\0';
 632   1      
 633   1          if(frame_state == 2)
 634   1              Uart_SendString("ERROR\r\n");
 635   1          else if(rx_len > 0)
 636   1              Uart_ParseOneCommand(0,rx_len-1,1);
 637   1          else
 638   1              Uart_SendString("ERROR\r\n");
 639   1      
 640   1          Uart_ClearRxBuffer();
 641   1      }
 642          
 643          bit Uart_ParseOneCommand(unsigned char start,unsigned char end,unsigned char reply_enable)
 644          {
 645   1          unsigned char len;
 646   1      
 647   1          if(end < start) return 0;
 648   1          len = end - start + 1;
 649   1      
 650   1          /* 通信测试：? → OK */
 651   1          if(len == 1 && RX1_Buffer[start] == '?')
 652   1          {
 653   2              if(reply_enable) Uart_SendString("OK\r\n");
 654   2              return 1;
 655   2          }
 656   1          /* R1/R0：继电器开/关（b_and_r bit4） */
 657   1          else if(len == 2 && RX1_Buffer[start] == 'R')
 658   1          {
 659   2              if(RX1_Buffer[start+1] == '1')
 660   2              {
 661   3                  b_and_r |= 0x10;          /* 继电器吸合 */
 662   3                  if(reply_enable) Uart_SendString("OK\r\n");
 663   3                  return 1;
 664   3              }
 665   2              else if(RX1_Buffer[start+1] == '0')
 666   2              {
 667   3                  b_and_r &= ~0x10;         /* 继电器释放 */
 668   3                  if(reply_enable) Uart_SendString("OK\r\n");
 669   3                  return 1;
 670   3              }
 671   2          }
 672   1          /* B1/B0：蜂鸣器开/关（b_and_r bit6） */
 673   1          else if(len == 2 && RX1_Buffer[start] == 'B')
C51 COMPILER V9.56.0.0   MAIN                                                              10/30/2026 20:47:17 PAGE 12  

 674   1          {
 675   2              if(RX1_Buffer[start+1] == '1')
 676   2              {
 677   3                  b_and_r |= 0x40;          /* 蜂鸣器鸣响 */
 678   3                  if(reply_enable) Uart_SendString("OK\r\n");
 679   3                  return 1;
 680   3              }
 681   2              else if(RX1_Buffer[start+1] == '0')
 682   2              {
 683   3                  b_and_r &= ~0x40;         /* 蜂鸣器关闭 */
 684   3                  if(reply_enable) Uart_SendString("OK\r\n");
 685   3                  return 1;
 686   3              }
 687   2          }
 688   1      
 689   1          if(reply_enable) Uart_SendString("ERROR\r\n");
 690   1          return 0;
 691   1      }
