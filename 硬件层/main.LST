 379          void Uart_SendString(char *str)
 380          {
 381   1          unsigned char i = 0;
 382   1      
 383   1          if(B_TX1_busy != 255) return;
 384   1          Uart_TxClear();
 385   1          while(str[i] != '\0' && i < TX1_LENGTH-1)
 386   1          {
