 222   1          disp_dirty = 0;
 223   1      
 224   1          switch(mode)
 225   1          {
 226   2              case 0:  /* 界面1：温度 xx.xx ℃ */
 227   2                  if(disp_temp < 0)
 228   2                  {
 229   3                      Seg_ShowFixed((unsigned long)(-disp_temp), 4, 3, 0);
 230   3                      seg[3] = 33;         /* 负号段码 Code[33]=0xBF（共阳，只亮 g 段） */
 231   3                  }
 232   2                  else
 233   2                      Seg_ShowFixed((unsigned long)disp_temp, 4, 3, 0);
 234   2                  break;
 235   2              case 1:  /* 界面2：光敏电压 x.xxx V */
 236   2                  Seg_ShowFixed(disp_light, 4, 4, 0);
 237   2                  break;
 238   2              case 2:  /* 界面3：电位器 x.xxx V */
 239   2                  Seg_ShowFixed(disp_pot, 4, 4, 0);
 240   2                  break;
C51 COMPILER V9.56.0.0   MAIN                                                              10/27/2026 15:45:48 PAGE 5   

 241   2              case 3:  /* 界面4：NE555 频率 Hz */
 242   2                  Seg_ShowFixed(ne555, 8, 0, 1);
 243   2                  break;
 244   2              default: /* 界面5：上传成功次数 */
 245   2                  Seg_ShowFixed(upload_count, 8, 0, 1);
 246   2                  break;
 247   2          }
 248   1      }
