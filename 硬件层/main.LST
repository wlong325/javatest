 166           * 前导零不显示；全为 0 时显示单个 0；每帧刷新（无需保存）。
 167           ******************************************************************************/
 168          void Display_Proc(void)
 169          {
 170   1          unsigned char i;
 171   1          unsigned char d;
 172   1          unsigned char show = 0;
