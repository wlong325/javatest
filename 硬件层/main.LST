 326          /********************************* 串口发送函数 ********************************/
 327          void Uart_SendString(char *str)
 328          {
 329   1          unsigned char i = 0;
 330   1      
 331   1          if(B_TX1_busy != 255) return;
 332   1          Uart_TxClear();
 333   1          while(str[i] != '\0' && i < TX1_LENGTH-1)
 334   1          {
 335   2              TX1_Buffer[i] = str[i];
 336   2              i++;
 337   2          }
 338   1          TX1_Buffer[i] = '\0';
 339   1          Uart_TxStart();
 340   1      }
 341          
 342          void Uart_TxClear(void)
 343          {
 344   1          unsigned char i;
 345   1          for(i=0;i<TX1_LENGTH;i++) TX1_Buffer[i] = 0;
 346   1      }
 347          
 348          void Uart_TxStart(void)
 349          {
 350   1          if(B_TX1_busy != 255) return;
 351   1          if(TX1_Buffer[0] == '\0') return;
 352   1          SBUF = TX1_Buffer[0];
 353   1          B_TX1_busy = 1;
 354   1      }
 355          
 356          void Uart_TxPutChar(unsigned char *idx,char dat)
 357          {
 358   1          if(*idx < TX1_LENGTH-1)
 359   1          {
 360   2              TX1_Buffer[*idx] = dat;
 361   2              (*idx)++;
 362   2              TX1_Buffer[*idx] = '\0';
 363   2          }
 364   1      }
