 427          void Uart_TxPutUInt(unsigned char *idx,unsigned int dat)
 428          {
 429   1          bit started = 0;
 430   1          unsigned int div;
 431   1      
 432   1          for(div=10000; div>0; div/=10)
 433   1          {
 434   2              if(dat >= div || started || div == 1)
 435   2              {
 436   3                  started = 1;
 437   3                  Uart_TxPutChar(idx,dat/div+'0');
 438   3                  dat %= div;
 439   3              }
 440   2          }
 441   1      }
