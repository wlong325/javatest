 227   1          {
 228   2              case 0:  /* 界面1：温度 xx.xx ℃ */
 229   2                  if(disp_temp < 0)
 230   2                  {
 231   3                      Seg_ShowFixed((unsigned long)(-disp_temp), 4, 3, 0);
 232   3                      seg[3] = 33;         /* 负号段码 Code[33]=0xBF（共阳，只亮 g 段） */
 233   3                  }
 234   2                  else
 235   2                      Seg_ShowFixed((unsigned long)disp_temp, 4, 3, 0);
 236   2                  break;
 237   2              case 1:  /* 界面2：光敏电压 x.xxx V */
 238   2                  Seg_ShowFixed(disp_light, 4, 4, 0);
 239   2                  break;
 240   2              case 2:  /* 界面3：电位器 x.xxx V */
