 220   2          }
 221   1      
 222   1          if(NE555_Task >= NE555_TASK_TIME)
 223   1          {
 224   2              NE555_Task = 0;
 225   2              TR0 = 0;
 226   2              ne555 = ((unsigned int)TH0 << 8) | TL0;
 227   2              TH0 = 0;
 228   2              TL0 = 0;
 229   2              TR0 = 1;
 230   2          }
 231   1      
 232   1          if(Send_Task >= SEND_TASK_TIME)
 233   1          {
 234   2              tx_i = 0;
 235   2              Send_Task = 0;
