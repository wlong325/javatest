 336          /********************************* PCA 中断 ***********************************/
 337          void CCP_IRQHandler(void) interrupt 7
 338          {
 339   1          if(CCF1)                 // 1ms 系统节拍
 340   1          {
 341   2              CCF1 = 0;
 342   2              CCAP1L = TIME_1;
 343   2              CCAP1H = TIME_1 >> 8;
 344   2              TIME_1 += TIME_CCAP1;
