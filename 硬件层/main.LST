 279          /********************************* 按键扫描 ***********************************/
 280          unsigned char Key_Read(void)
 281          {
 282   1          P44=0;P42=1;P35=1;
 283   1          P33=1;P32=1;
 284   1          if(!P33)return 4;      /* S4：启动发送 */
 285   1          else if(!P32)return 5; /* S5 */
 286   1          P44=1;P42=0;
 287   1          if(!P33)return 8;      /* S8 */
 288   1          else if(!P32)return 9; /* S9 */
 289   1          P42=1;P35=0;
 290   1          if(!P33)return 12;     /* S12 */
 291   1          else if(!P32)return 13;/* S13 */
 292   1          return 0;
 293   1      }
