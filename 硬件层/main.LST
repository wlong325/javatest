 184          /********************************* 数码管显示 *********************************
 185           * 5 个界面由 S4 循环切换（mode 0~4）：
 186           *   界面1：温度 xx.xx℃；界面2：光敏 x.xxxV；界面3：电位器 x.xxxV；
 187           *   界面4：NE555 频率；界面5：上传成功次数。
 188           * 界面1~3 的值来自最近一次采集（即发送帧内容），每帧刷新。
 189           * 小数点显示用带点段码（Code[d+16]），point 为从右数第几位带点。
 190           ******************************************************************************/
 191          void Seg_ShowFixed(unsigned long val, unsigned char digits, unsigned char point, bit hide_zero)
 192          {
 193   1          unsigned char i;
 194   1          unsigned char d;
 195   1          unsigned char show = 0;
 196   1          unsigned char pos = 8 - digits;
 197   1          unsigned char tmp[8];
 198   1      
 199   1          for(i=0;i<digits;i++)            /* 按高位顺序拆出各位（只用除10/取模） */
 200   1          {
 201   2              tmp[digits - 1 - i] = (unsigned char)(val % 10);
 202   2              val /= 10;
 203   2          }
 204   1          for(i=0;i<8;i++) seg[i] = SEG_BLANK;
 205   1      
 206   1          for(i=0;i<digits;i++, pos++)
 207   1          {
 208   2              d = tmp[i];
 209   2              if(hide_zero && show == 0 && d == 0 && i < digits - 1)
 210   2                  seg[pos] = SEG_BLANK;
 211   2              else
 212   2              {
 213   3                  show = 1;
 214   3                  seg[pos] = ((digits - i) == point) ? (d + 16) : d;
 215   3              }
 216   2          }
 217   1      }
