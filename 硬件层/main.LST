 724          /********************************* 温度换算 ************************************/
 725          long int DS18B20_ToIntC(unsigned int raw)
 726          {
 727   1          /* 返回温度×100，例 2706 = 27.06℃（DS18B20 每 LSB = 0.0625℃） */
 728   1          if(raw & 0xF000)    /* 负温度（12 位补码） */
 729   1          {
 730   2              return -((long int)((0x10000 - raw) & 0xFFFF) * 625 / 100);
 731   2          }
 732   1          return (long int)raw * 625 / 100;
 733   1      }


