 613          /********************************* 串口发送函数 ********************************/
 614          void Uart_SendString(char *str)
 615          {
 616   1          unsigned char i = 0;
 617   1      
 618   1          if(B_TX1_busy != 255) return;
 619   1          Uart_TxClear();
 620   1          while(str[i] != '\0' && i < TX1_LENGTH-1)
 621   1          {
 622   2              TX1_Buffer[i] = str[i];
 623   2              i++;
 624   2          }
 625   1          TX1_Buffer[i] = '\0';
 626   1          Uart_TxStart();
 627   1      }
 628          
 629          void Uart_TxClear(void)
 630          {
 631   1          unsigned char i;
 632   1          for(i=0;i<TX1_LENGTH;i++) TX1_Buffer[i] = 0;
 633   1      }
 634          
 635          void Uart_TxStart(void)
 636          {
 637   1          if(B_TX1_busy != 255) return;
 638   1          if(TX1_Buffer[0] == '\0') return;
 639   1          SBUF = TX1_Buffer[0];
 640   1          B_TX1_busy = 1;
 641   1      }
