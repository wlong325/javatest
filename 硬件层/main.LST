 178          void HC573_Write(unsigned char channel,unsigned char dat)
C51 COMPILER V9.56.0.0   MAIN                                                              11/03/2026 13:12:53 PAGE 4   

 179          {
 180   1          P2 &= 0x1f;
 181   1          P0 = dat;
 182   1          switch(channel)
 183   1          {
 184   2              case 4: P2 = (P2 & 0x1f) | 0x80; break;
 185   2              case 5: P2 = (P2 & 0x1f) | 0xa0; break;
 186   2              case 6: P2 = (P2 & 0x1f) | 0xc0; break;
 187   2              case 7: P2 = (P2 & 0x1f) | 0xe0; break;
 188   2              default: break;
 189   2          }
 190   1          P2 &= 0x1f;
 191   1      }
