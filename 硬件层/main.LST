 437          /********************************* 温度换算 ************************************/
 438          long int DS18B20_ToIntC(unsigned int raw)
 439          {
 440   1          if(raw & 0xF000)
 441   1          {
 442   2              if(((raw ^ 0xFFFF) & 0x000F) == 0x000F)
 443   2                  return -((long int)((raw ^ 0xFFFF) >> 4)) - 1;
 444   2              else
 445   2                  return -((long int)((raw ^ 0xFFFF) >> 4));
 446   2          }
 447   1          return (long int)(raw >> 4);
 448   1      }


