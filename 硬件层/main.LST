 165          void HC573_Write(unsigned char channel,unsigned char dat)
 166          {
 167   1          P2 &= 0x1f;
 168   1          P0 = dat;
 169   1          switch(channel)
 170   1          {
 171   2              case 4: P2 = (P2 & 0x1f) | 0x80; break;
 172   2              case 5: P2 = (P2 & 0x1f) | 0xa0; break;
 173   2              case 6: P2 = (P2 & 0x1f) | 0xc0; break;
 174   2              case 7: P2 = (P2 & 0x1f) | 0xe0; break;
 175   2              default: break;
 176   2          }
 177   1          P2 &= 0x1f;
 178   1      }
