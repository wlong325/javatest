 260          /********************************* 串口中断 ***********************************
 261           * 仅发送方向：TI 中断逐字节发送 TX1_Buffer；RI 丢弃（本机只发不收）。
 262           ******************************************************************************/
 263          void uart_0(void) interrupt 4
 264          {
 265   1          if(RI)
 266   1          {
 267   2              RI = 0;                  // 丢弃接收字节
 268   2          }
 269   1      
 270   1          if(TI)
 271   1          {
 272   2              TI = 0;
 273   2              if(B_TX1_busy != 255 && TX1_Buffer[B_TX1_busy] != '\0')
 274   2              {
 275   3                  SBUF = TX1_Buffer[B_TX1_busy];
 276   3                  B_TX1_busy++;
 277   3              }
 278   2              else
 279   2              {
 280   3                  B_TX1_busy = 255;
 281   3              }
 282   2          }
 283   1      }
 284          
 285          /********************************* PCA 中断 ***********************************/
 286          void CCP_IRQHandler(void) interrupt 7
 287          {
 288   1          if(CCF1)                 // 1ms 系统节拍
 289   1          {
 290   2              CCF1 = 0;
 291   2              CCAP1L = TIME_1;
 292   2              CCAP1H = TIME_1 >> 8;
 293   2              TIME_1 += TIME_CCAP1;
 294   2      
 295   2              if(PCF8591_Task < PCF8591_TASK_TIME) PCF8591_Task++;
 296   2              if(DS18B20_Task < DS18B20_TASK_TIME) DS18B20_Task++;
 297   2              if(NE555_Task < NE555_TASK_TIME) NE555_Task++;
 298   2              if(Send_Task < SEND_TASK_TIME) Send_Task++;
 299   2      
 300   2              if(tx_led_on)
 301   2              {
 302   3                  if(TX_LED_Task < LED_BLINK_TIME) TX_LED_Task++;
C51 COMPILER V9.56.0.0   MAIN                                                              10/25/2026 21:51:13 PAGE 6   

 303   3                  else
 304   3                  {
 305   4                      TX_LED_Task = 0;
 306   4                      tx_led_on = 0;
 307   4                  }
 308   3              }
 309   2          }
 310   1      
 311   1          if(CCF2)                 // 显示刷新
 312   1          {
 313   2              CCF2 = 0;
 314   2              CCAP2L = TIME_2;
 315   2              CCAP2H = TIME_2 >> 8;
 316   2              TIME_2 += TIME_CCAP2;
 317   2      
 318   2              HC573_Write(4,~led);
 319   2              HC573_Write(7,0xff);
 320   2              HC573_Write(6,1 << (SEG_Count % 8));
 321   2              HC573_Write(7,Code[seg[SEG_Count % 8]]);
 322   2              SEG_Count++;
 323   2          }
 324   1      }
