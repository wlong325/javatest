 438          /********************************* 按键扫描 ***********************************/
 439          unsigned char Key_Read(void)
 440          {
 441   1          P44=0;P42=1;P35=1;
 442   1          P33=1;P32=1;
 443   1          if(!P33)return 4;      /* S4：启动发送 */
 444   1          else if(!P32)return 5; /* S5 */
 445   1          P44=1;P42=0;
 446   1          if(!P33)return 8;      /* S8 */
 447   1          else if(!P32)return 9; /* S9 */
 448   1          P42=1;P35=0;
 449   1          if(!P33)return 12;     /* S12 */
 450   1          else if(!P32)return 13;/* S13 */
 451   1          return 0;
 452   1      }
 453          
 454          void Key_Proc(void)
 455          {
 456   1          if(KEY_Task < KEY_TASK_TIME) return;
 457   1          KEY_Task = 0;
 458   1      
 459   1          key_val = Key_Read();
 460   1          key_down = key_val & (key_val ^ key_old);
 461   1          key_old = key_val;
 462   1      
 463   1          if(key_down == 4)          /* S4：界面 1~5 循环切换 */
 464   1          {
 465   2              mode++;
 466   2              if(mode > 4) mode = 0;
 467   2              disp_dirty = 1;
 468   2          }
 469   1          else if(key_down == 8)     /* S8：按一次后开始发送 */
 470   1          {
 471   2              send_enable = 1;
 472   2              Send_Task = SEND_TASK_TIME;   /* 立即触发第一帧 */
 473   2          }
 474   1      }
