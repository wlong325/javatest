 685          void Uart_TxPutChar(unsigned char *idx,char dat)
 686          {
 687   1          if(*idx < TX1_LENGTH-1)
 688   1          {
 689   2              TX1_Buffer[*idx] = dat;
 690   2              (*idx)++;
 691   2              TX1_Buffer[*idx] = '\0';
 692   2          }
 693   1      }
