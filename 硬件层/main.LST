 523          /********************************* 串口接收处理 ********************************
 524           * 双向控制：命令帧由桥通过串口下发，10ms 空闲判帧结束，主循环解析执行。
 525           * 命令表：? → OK；R1/R0 → 继电器开/关；B1/B0 → 蜂鸣器开/关。
 526           * 执行后回 OK；命令不识别回 ERROR。继电器/蜂鸣器改影子变量 b_and_r，
 527           * 由 CCF2 中断统一写入 74HC573 通道 5（bit4=继电器，bit6=蜂鸣器）。
 528           ******************************************************************************/
 529          void Uart_ClearRxBuffer(void)
 530          {
 531   1          unsigned char i;
 532   1          for(i=0;i<RX1_LENGTH;i++) RX1_Buffer[i] = 0;
 533   1          B_RX1_Con = 0;
 534   1          UART_Idle_Task = 0;
 535   1          B_RX1_flag = 0;
 536   1      }
 537          
 538          void Uart_Proc(void)
 539          {
 540   1          unsigned char rx_len;
 541   1          unsigned char frame_state;
 542   1      
 543   1          frame_state = B_RX1_flag;
 544   1          if(frame_state == 0) return;
 545   1      
 546   1          rx_len = B_RX1_Con;
 547   1          while(rx_len > 0 && (RX1_Buffer[rx_len-1] == '\r' || RX1_Buffer[rx_len-1] == '\n'))
 548   1          {
 549   2              rx_len--;
 550   2          }
C51 COMPILER V9.56.0.0   MAIN                                                              10/27/2026 15:45:48 PAGE 10  

 551   1          RX1_Buffer[rx_len] = '\0';
 552   1      
 553   1          if(frame_state == 2)
 554   1              Uart_SendString("ERROR\r\n");
 555   1          else if(rx_len > 0)
 556   1              Uart_ParseOneCommand(0,rx_len-1,1);
 557   1          else
 558   1              Uart_SendString("ERROR\r\n");
 559   1      
 560   1          Uart_ClearRxBuffer();
 561   1      }
 562          
 563          bit Uart_ParseOneCommand(unsigned char start,unsigned char end,unsigned char reply_enable)
 564          {
 565   1          unsigned char len;
 566   1      
 567   1          if(end < start) return 0;
 568   1          len = end - start + 1;
 569   1      
 570   1          /* 通信测试：? → OK */
 571   1          if(len == 1 && RX1_Buffer[start] == '?')
 572   1          {
 573   2              if(reply_enable) Uart_SendString("OK\r\n");
 574   2              return 1;
 575   2          }
 576   1          /* R1/R0：继电器开/关（b_and_r bit4） */
 577   1          else if(len == 2 && RX1_Buffer[start] == 'R')
 578   1          {
 579   2              if(RX1_Buffer[start+1] == '1')
 580   2              {
 581   3                  b_and_r |= 0x10;          /* 继电器吸合 */
 582   3                  if(reply_enable) Uart_SendString("OK\r\n");
 583   3                  return 1;
 584   3              }
 585   2              else if(RX1_Buffer[start+1] == '0')
 586   2              {
 587   3                  b_and_r &= ~0x10;         /* 继电器释放 */
 588   3                  if(reply_enable) Uart_SendString("OK\r\n");
 589   3                  return 1;
 590   3              }
 591   2          }
 592   1          /* B1/B0：蜂鸣器开/关（b_and_r bit6） */
 593   1          else if(len == 2 && RX1_Buffer[start] == 'B')
 594   1          {
 595   2              if(RX1_Buffer[start+1] == '1')
 596   2              {
 597   3                  b_and_r |= 0x40;          /* 蜂鸣器鸣响 */
 598   3                  if(reply_enable) Uart_SendString("OK\r\n");
 599   3                  return 1;
 600   3              }
 601   2              else if(RX1_Buffer[start+1] == '0')
 602   2              {
 603   3                  b_and_r &= ~0x40;         /* 蜂鸣器关闭 */
 604   3                  if(reply_enable) Uart_SendString("OK\r\n");
 605   3                  return 1;
 606   3              }
 607   2          }
 608   1      
 609   1          if(reply_enable) Uart_SendString("ERROR\r\n");
 610   1          return 0;
 611   1      }
