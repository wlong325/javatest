 117          /********************************* 初始化 ************************************/
 118          void System_Init(void)
 119          {
 120   1          HC573_Write(4,0xff);
 121   1          HC573_Write(5,0x00);
 122   1          HC573_Write(6,0x00);
 123   1          HC573_Write(7,0xff);
 124   1      
 125   1          Display_Clear();
 126   1          Timer0Init();
 127   1          Timer1Init();
 128   1          uart_init();
 129   1          EA = 1;
 130   1      }
 131          
 132          void HC573_Write(unsigned char channel,unsigned char dat)
 133          {
 134   1          P2 &= 0x1f;
 135   1          P0 = dat;
 136   1          switch(channel)
 137   1          {
 138   2              case 4: P2 = (P2 & 0x1f) | 0x80; break;
 139   2              case 5: P2 = (P2 & 0x1f) | 0xa0; break;
 140   2              case 6: P2 = (P2 & 0x1f) | 0xc0; break;
 141   2              case 7: P2 = (P2 & 0x1f) | 0xe0; break;
 142   2              default: break;
 143   2          }
 144   1          P2 &= 0x1f;
 145   1      }
