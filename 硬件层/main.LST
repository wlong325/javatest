 408          void Uart_TxPutChar(unsigned char *idx,char dat)
 409          {
 410   1          if(*idx < TX1_LENGTH-1)
 411   1          {
 412   2              TX1_Buffer[*idx] = dat;
 413   2              (*idx)++;
 414   2              TX1_Buffer[*idx] = '\0';
 415   2          }
 416   1      }
 417          
 418          void Uart_TxPutString(unsigned char *idx,char *str)
 419          {
 420   1          while(*str != '\0')
 421   1          {
 422   2              Uart_TxPutChar(idx,*str);
 423   2              str++;
 424   2          }
