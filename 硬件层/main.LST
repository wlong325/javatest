 766          /********************************* 温度换算 ************************************/
 767          long int DS18B20_ToIntC(unsigned int raw)
 768          {
 769   1          /* 返回温度×100，例 2706 = 27.06℃（DS18B20 每 LSB = 0.0625℃） */
 770   1          if(raw & 0xF000)    /* 负温度（12 位补码） */
 771   1          {
 772   2              return -((long int)((0x10000 - raw) & 0xFFFF) * 625 / 100);
 773   2          }
 774   1          return (long int)raw * 625 / 100;
 775   1      }


