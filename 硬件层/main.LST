 565          /********************************* 串口接收处理 ********************************
 566           * 双向控制：命令帧由桥通过串口下发，10ms 空闲判帧结束，主循环解析执行。
 567           * 命令表：? → OK；R1/R0 → 继电器开/关；B1/B0 → 蜂鸣器开/关。
 568           * 执行后回 OK；命令不识别回 ERROR。继电器/蜂鸣器改影子变量 b_and_r，
 569           * 由 CCF2 中断统一写入 74HC573 通道 5（bit4=继电器，bit6=蜂鸣器）。
 570           ******************************************************************************/
 571          void Uart_ClearRxBuffer(void)
 572          {
 573   1          unsigned char i;
 574   1          for(i=0;i<RX1_LENGTH;i++) RX1_Buffer[i] = 0;
 575   1          B_RX1_Con = 0;
 576   1          UART_Idle_Task = 0;
 577   1          B_RX1_flag = 0;
 578   1      }
 579          
 580          void Uart_Proc(void)
 581          {
 582   1          unsigned char rx_len;
 583   1          unsigned char frame_state;
 584   1      
 585   1          frame_state = B_RX1_flag;
 586   1          if(frame_state == 0) return;
 587   1      
 588   1          rx_len = B_RX1_Con;
 589   1          while(rx_len > 0 && (RX1_Buffer[rx_len-1] == '\r' || RX1_Buffer[rx_len-1] == '\n'))
 590   1          {
 591   2              rx_len--;
 592   2          }
 593   1          RX1_Buffer[rx_len] = '\0';
 594   1      
 595   1          if(frame_state == 2)
 596   1              Uart_SendString("ERROR\r\n");
 597   1          else if(rx_len > 0)
 598   1              Uart_ParseOneCommand(0,rx_len-1,1);
 599   1          else
 600   1              Uart_SendString("ERROR\r\n");
 601   1      
 602   1          Uart_ClearRxBuffer();
 603   1      }
 604          
 605          bit Uart_ParseOneCommand(unsigned char start,unsigned char end,unsigned char reply_enable)
 606          {
 607   1          unsigned char len;
 608   1      
 609   1          if(end < start) return 0;
 610   1          len = end - start + 1;
 611   1      
C51 COMPILER V9.56.0.0   MAIN                                                              11/02/2026 09:25:38 PAGE 11  

 612   1          /* 通信测试：? → OK */
 613   1          if(len == 1 && RX1_Buffer[start] == '?')
 614   1          {
 615   2              if(reply_enable) Uart_SendString("OK\r\n");
 616   2              return 1;
 617   2          }
 618   1          /* R1/R0：继电器开/关（b_and_r bit4） */
 619   1          else if(len == 2 && RX1_Buffer[start] == 'R')
 620   1          {
 621   2              if(RX1_Buffer[start+1] == '1')
 622   2              {
 623   3                  b_and_r |= 0x10;          /* 继电器吸合 */
 624   3                  if(reply_enable) Uart_SendString("OK\r\n");
 625   3                  return 1;
 626   3              }
 627   2              else if(RX1_Buffer[start+1] == '0')
 628   2              {
 629   3                  b_and_r &= ~0x10;         /* 继电器释放 */
 630   3                  if(reply_enable) Uart_SendString("OK\r\n");
 631   3                  return 1;
 632   3              }
 633   2          }
 634   1          /* B1/B0：蜂鸣器开/关（b_and_r bit6） */
 635   1          else if(len == 2 && RX1_Buffer[start] == 'B')
 636   1          {
 637   2              if(RX1_Buffer[start+1] == '1')
 638   2              {
 639   3                  b_and_r |= 0x40;          /* 蜂鸣器鸣响 */
 640   3                  if(reply_enable) Uart_SendString("OK\r\n");
 641   3                  return 1;
 642   3              }
 643   2              else if(RX1_Buffer[start+1] == '0')
 644   2              {
 645   3                  b_and_r &= ~0x40;         /* 蜂鸣器关闭 */
 646   3                  if(reply_enable) Uart_SendString("OK\r\n");
 647   3                  return 1;
 648   3              }
 649   2          }
 650   1      
 651   1          if(reply_enable) Uart_SendString("ERROR\r\n");
 652   1          return 0;
 653   1      }
