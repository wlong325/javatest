 365          
 366          void Uart_TxPutString(unsigned char *idx,char *str)
 367          {
 368   1          while(*str != '\0')
 369   1          {
 370   2              Uart_TxPutChar(idx,*str);
 371   2              str++;
 372   2          }
 373   1      }
 374          
 375          void Uart_TxPutUInt(unsigned char *idx,unsigned int dat)
 376          {
 377   1          bit started = 0;
 378   1          unsigned int div;
 379   1      
 380   1          for(div=10000; div>0; div/=10)
 381   1          {
 382   2              if(dat >= div || started || div == 1)
 383   2              {
 384   3                  started = 1;
 385   3                  Uart_TxPutChar(idx,dat/div+'0');
 386   3                  dat %= div;
 387   3              }
 388   2          }
 389   1      }
