 186          /********************************* 数码管显示 *********************************
 187           * 5 个界面由 S4 循环切换（mode 0~4）：
 188           *   界面1：温度 xx.xx℃；界面2：光敏 x.xxxV；界面3：电位器 x.xxxV；
 189           *   界面4：NE555 频率；界面5：上传成功次数。
 190           * 界面1~3 的值来自最近一次采集（即发送帧内容），每帧刷新。
 191           * 小数点显示用带点段码（Code[d+16]），point 为从右数第几位带点。
 192           ******************************************************************************/
 193          void Seg_ShowFixed(unsigned long val, unsigned char digits, unsigned char point, bit hide_zero)
 194          {
 195   1          unsigned char i;
 196   1          unsigned char d;
 197   1          unsigned char show = 0;
 198   1          unsigned char pos = 8 - digits;
 199   1          unsigned char tmp[8];
 200   1      
 201   1          for(i=0;i<digits;i++)            /* 按高位顺序拆出各位（只用除10/取模） */
 202   1          {
 203   2              tmp[digits - 1 - i] = (unsigned char)(val % 10);
 204   2              val /= 10;
 205   2          }
 206   1          for(i=0;i<8;i++) seg[i] = SEG_BLANK;
 207   1      
 208   1          for(i=0;i<digits;i++, pos++)
 209   1          {
 210   2              d = tmp[i];
 211   2              if(hide_zero && show == 0 && d == 0 && i < digits - 1)
 212   2                  seg[pos] = SEG_BLANK;
 213   2              else
 214   2              {
 215   3                  show = 1;
 216   3                  seg[pos] = ((digits - i) == point) ? (d + 16) : d;
 217   3              }
 218   2          }
 219   1      }
