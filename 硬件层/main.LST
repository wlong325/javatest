 199          /********************************* 数码管显示 *********************************
 200           * 5 个界面由 S4 循环切换（mode 0~4）：
 201           *   界面1：温度 xx.xx℃；界面2：光敏 x.xxxV；界面3：电位器 x.xxxV；
 202           *   界面4：NE555 频率；界面5：上传成功次数。
 203           * 界面1~3 的值来自最近一次采集（即发送帧内容），每帧刷新。
 204           * 小数点显示用带点段码（Code[d+16]），point 为从右数第几位带点。
 205           ******************************************************************************/
 206          void Seg_ShowFixed(unsigned long val, unsigned char digits, unsigned char point, bit hide_zero)
 207          {
 208   1          unsigned char i;
 209   1          unsigned char d;
 210   1          unsigned char show = 0;
 211   1          unsigned char pos = 8 - digits;
 212   1          unsigned char tmp[8];
 213   1      
 214   1          for(i=0;i<digits;i++)            /* 按高位顺序拆出各位（只用除10/取模） */
 215   1          {
 216   2              tmp[digits - 1 - i] = (unsigned char)(val % 10);
 217   2              val /= 10;
 218   2          }
 219   1          for(i=0;i<8;i++) seg[i] = SEG_BLANK;
 220   1      
 221   1          for(i=0;i<digits;i++, pos++)
 222   1          {
 223   2              d = tmp[i];
 224   2              if(hide_zero && show == 0 && d == 0 && i < digits - 1)
 225   2                  seg[pos] = SEG_BLANK;
 226   2              else
 227   2              {
 228   3                  show = 1;
 229   3                  seg[pos] = ((digits - i) == point) ? (d + 16) : d;
 230   3              }
 231   2          }
 232   1      }
