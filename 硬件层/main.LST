 397          unsigned char Key_Read(void)
 398          {
 399   1          P44=0;P42=1;P35=1;
 400   1          P33=1;P32=1;
 401   1          if(!P33)return 4;      /* S4：启动发送 */
 402   1          else if(!P32)return 5; /* S5 */
 403   1          P44=1;P42=0;
 404   1          if(!P33)return 8;      /* S8 */
 405   1          else if(!P32)return 9; /* S9 */
 406   1          P42=1;P35=0;
 407   1          if(!P33)return 12;     /* S12 */
 408   1          else if(!P32)return 13;/* S13 */
 409   1          return 0;
 410   1      }
