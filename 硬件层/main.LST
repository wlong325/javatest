 143          void HC573_Write(unsigned char channel,unsigned char dat)
 144          {
 145   1          P2 &= 0x1f;
 146   1          P0 = dat;
 147   1          switch(channel)
 148   1          {
 149   2              case 4: P2 = (P2 & 0x1f) | 0x80; break;
 150   2              case 5: P2 = (P2 & 0x1f) | 0xa0; break;
 151   2              case 6: P2 = (P2 & 0x1f) | 0xc0; break;
 152   2              case 7: P2 = (P2 & 0x1f) | 0xe0; break;
 153   2              default: break;
 154   2          }
 155   1          P2 &= 0x1f;
 156   1      }
