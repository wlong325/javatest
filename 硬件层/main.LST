 174          void HC573_Write(unsigned char channel,unsigned char dat)
 175          {
 176   1          P2 &= 0x1f;
 177   1          P0 = dat;
 178   1          switch(channel)
C51 COMPILER V9.56.0.0   MAIN                                                              10/30/2026 20:47:17 PAGE 4   

 179   1          {
 180   2              case 4: P2 = (P2 & 0x1f) | 0x80; break;
 181   2              case 5: P2 = (P2 & 0x1f) | 0xa0; break;
 182   2              case 6: P2 = (P2 & 0x1f) | 0xc0; break;
 183   2              case 7: P2 = (P2 & 0x1f) | 0xe0; break;
 184   2              default: break;
 185   2          }
 186   1          P2 &= 0x1f;
 187   1      }
