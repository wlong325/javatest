 195          /********************************* 数码管显示 *********************************
 196           * 5 个界面由 S4 循环切换（mode 0~4）：
 197           *   界面1：温度 xx.xx℃；界面2：光敏 x.xxxV；界面3：电位器 x.xxxV；
 198           *   界面4：NE555 频率；界面5：上传成功次数。
 199           * 界面1~3 的值来自最近一次采集（即发送帧内容），每帧刷新。
 200           * 小数点显示用带点段码（Code[d+16]），point 为从右数第几位带点。
 201           ******************************************************************************/
 202          void Seg_ShowFixed(unsigned long val, unsigned char digits, unsigned char point, bit hide_zero)
 203          {
 204   1          unsigned char i;
 205   1          unsigned char d;
 206   1          unsigned char show = 0;
 207   1          unsigned char pos = 8 - digits;
 208   1          unsigned char tmp[8];
 209   1      
 210   1          for(i=0;i<digits;i++)            /* 按高位顺序拆出各位（只用除10/取模） */
 211   1          {
 212   2              tmp[digits - 1 - i] = (unsigned char)(val % 10);
 213   2              val /= 10;
 214   2          }
 215   1          for(i=0;i<8;i++) seg[i] = SEG_BLANK;
 216   1      
 217   1          for(i=0;i<digits;i++, pos++)
 218   1          {
 219   2              d = tmp[i];
 220   2              if(hide_zero && show == 0 && d == 0 && i < digits - 1)
 221   2                  seg[pos] = SEG_BLANK;
 222   2              else
 223   2              {
 224   3                  show = 1;
 225   3                  seg[pos] = ((digits - i) == point) ? (d + 16) : d;
 226   3              }
 227   2          }
 228   1      }
