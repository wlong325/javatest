 643          void Uart_TxPutChar(unsigned char *idx,char dat)
 644          {
 645   1          if(*idx < TX1_LENGTH-1)
 646   1          {
 647   2              TX1_Buffer[*idx] = dat;
 648   2              (*idx)++;
 649   2              TX1_Buffer[*idx] = '\0';
 650   2          }
 651   1      }
 652          
 653          void Uart_TxPutString(unsigned char *idx,char *str)
 654          {
 655   1          while(*str != '\0')
 656   1          {
 657   2              Uart_TxPutChar(idx,*str);
 658   2              str++;
 659   2          }
 660   1      }
 661          
 662          void Uart_TxPutUInt(unsigned char *idx,unsigned int dat)
 663          {
 664   1          bit started = 0;
 665   1          unsigned int div;
 666   1      
 667   1          for(div=10000; div>0; div/=10)
 668   1          {
 669   2              if(dat >= div || started || div == 1)
 670   2              {
 671   3                  started = 1;
 672   3                  Uart_TxPutChar(idx,dat/div+'0');
 673   3                  dat %= div;
 674   3              }
