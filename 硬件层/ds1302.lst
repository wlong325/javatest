  58   1        RST=0;  _nop_();
  59   1        SCK=0;  _nop_();
  60   1        SCK=1;  _nop_();
  61   1        SDA=0;  _nop_();
  62   1        SDA=1;  _nop_();
  63   1        return (temp);      
  64   1      }
  65          
  66          void Set_RTC(unsigned char* pucRtc)
  67          {
  68   1          unsigned char temp;
  69   1          
  70   1          Write_Ds1302_Byte(0x8e,0);
  71   1          temp=((pucRtc[0]/10)<<4)+pucRtc[0]%10;
  72   1          Write_Ds1302_Byte(0x84,temp);
  73   1          temp=((pucRtc[1]/10)<<4)+pucRtc[1]%10;
  74   1          Write_Ds1302_Byte(0x82,temp);
  75   1          temp=((pucRtc[2]/10)<<4)+pucRtc[2]%10;
  76   1          Write_Ds1302_Byte(0x80,temp);
  77   1          Write_Ds1302_Byte(0x8e,0x90);
  78   1      }
  79          
  80          void Read_RTC(unsigned char* pucRtc)
  81          {
  82   1          unsigned char temp;
  83   1          
  84   1          temp=Read_Ds1302_Byte(0x85);
  85   1          pucRtc[0]=(temp>>4)*10+(temp&0x0f);
  86   1          temp=Read_Ds1302_Byte(0x83);
  87   1          pucRtc[1]=(temp>>4)*10+(temp&0x0f);
  88   1          temp=Read_Ds1302_Byte(0x81);
  89   1          pucRtc[2]=(temp>>4)*10+(temp&0x0f);
  90   1      }


