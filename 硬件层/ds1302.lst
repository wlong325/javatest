  18          #include "ds1302.h"
  19          void Write_Ds1302(unsigned  char temp) 
  20          {
  21   1        unsigned char i;
  22   1        for (i=0;i<8;i++)       
  23   1        { 
  24   2          SCK = 0;
  25   2          SDA = temp&0x01;
  26   2          temp>>=1; 
  27   2          SCK=1;
  28   2        }
  29   1      }   
  30          
  31          //
  32          void Write_Ds1302_Byte( unsigned char address,unsigned char dat )     
  33          {
  34   1        RST=0;  _nop_();
  35   1        SCK=0;  _nop_();
  36   1        RST=1;  _nop_();  
  37   1        Write_Ds1302(address);  
  38   1        Write_Ds1302(dat);    
  39   1        RST=0; 
  40   1      }
  41          
  42          //
  43          unsigned char Read_Ds1302_Byte ( unsigned char address )
  44          {
  45   1        unsigned char i,temp=0x00;
  46   1        RST=0;  _nop_();
  47   1        SCK=0;  _nop_();
  48   1        RST=1;  _nop_();
  49   1        Write_Ds1302(address);
  50   1        for (i=0;i<8;i++)   
  51   1        {   
  52   2          SCK=0;
  53   2          temp>>=1; 
  54   2          if(SDA)
