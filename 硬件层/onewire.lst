  20          //
  21          void Delay_OneWire(unsigned int t)  
  22          {
  23   1          unsigned char i;
  24   1          while(t--)
  25   1          {
  26   2              for(i=0;i<12;i++);
  27   2          }
  28   1      }
  29          
  30          //
  31          void Write_DS18B20(unsigned char dat)
  32          {
  33   1        unsigned char i;
  34   1        for(i=0;i<8;i++)
  35   1        {
  36   2          DQ = 0;
  37   2              DQ = dat&0x01;
  38   2              Delay_OneWire(5);
  39   2          DQ = 1;
  40   2          dat >>= 1;
  41   2        }
  42   1        Delay_OneWire(5);
  43   1      }
  44          
  45          //
  46          unsigned char Read_DS18B20(void)
  47          {
  48   1        unsigned char i;
  49   1        unsigned char dat;
  50   1        
  51   1        for(i=0;i<8;i++)
  52   1        {
  53   2          DQ = 0;
  54   2          dat >>= 1;
C51 COMPILER V9.56.0.0   ONEWIRE                                                           10/25/2026 21:13:44 PAGE 2   

  55   2          DQ = 1;
  56   2          if(DQ)
  57   2          {
  58   3            dat |= 0x80;
  59   3          }     
  60   2          Delay_OneWire(5);
  61   2        }
  62   1        return dat;
  63   1      }
  64          
  65          
  66          //
  67          bit init_ds18b20(void)
  68          {
  69   1          bit initflag = 0;
  70   1          
  71   1          DQ = 1;
  72   1          Delay_OneWire(12);
  73   1          DQ = 0;
  74   1          Delay_OneWire(80);
  75   1          DQ = 1;
  76   1          Delay_OneWire(10); 
  77   1          initflag = DQ;     
  78   1          Delay_OneWire(5);
  79   1        
  80   1          return initflag;
  81   1      }
  82          
  83          #ifdef Enbale_DS18B20_Precision_adjustment
              void set_ds18b20()
              {
                  init_ds18b20();
                  Write_DS18B20(0xCC);
                  Write_DS18B20(0x4e);
                  Write_DS18B20(0x7f);
                  Write_DS18B20(0x00);
                  Write_DS18B20(0x1f);
                  init_ds18b20();
              }
              #endif
