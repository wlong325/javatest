  97          unsigned int rd_temperature() 
  98          { 
  99   1          unsigned char low, high;
 100   1          init_ds18b20();
 101   1          Write_DS18B20(0xCC); 
 102   1          Write_DS18B20(0x44); 
 103   1          Delay_OneWire(2);
 104   1          init_ds18b20(); 
 105   1          Write_DS18B20(0xCC); 
 106   1          Write_DS18B20(0xBE);
 107   1          low = Read_DS18B20(); 
 108   1          high = Read_DS18B20();
 109   1      //    low = 0x90;
 110   1      //    high = 0xFC;
 111   1          return (high<<8)+low;
 112   1      } 
