 152          #ifdef EEPROM_AT24C02 
 153          void EEPROM_Read(unsigned char* pucBuf, unsigned char addr, unsigned char num) 
 154          { 
 155   1          IIC_Start(); 
 156   1          IIC_SendByte(0xa0); 
 157   1          IIC_WaitAck(); 
 158   1          IIC_SendByte(addr); 
 159   1          IIC_WaitAck(); 
 160   1          IIC_Start(); 
 161   1          IIC_SendByte(0xa1); 
 162   1          IIC_WaitAck(); 
 163   1          while(num--) 
 164   1          { 
 165   2              *pucBuf++ = IIC_RecByte(); 
 166   2              if(num) IIC_SendAck(0); 
 167   2              else IIC_SendAck(1); 
 168   2          } 
 169   1          IIC_Stop(); 
 170   1      } 
 171          void EEPROM_Write(unsigned char* pucBuf, unsigned char addr, unsigned char num) 
 172          {
 173   1          IIC_Start(); 
 174   1          IIC_SendByte(0xa0); 
 175   1          IIC_WaitAck(); 
 176   1          IIC_SendByte(addr); 
