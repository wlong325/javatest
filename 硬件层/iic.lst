  17          #include "iic.h"
  18          
  19          #define DELAY_TIME  5
  20          
  21          
  22          //
  23          void IIC_Delay(unsigned char i)
  24          {
  25   1          do{_nop_();}
  26   1          while(i--);
  27   1      }
  28          
  29          
  30          //
  31          void IIC_Start(void)
  32          {
  33   1          SDA_IIC = 1;
  34   1          SCL_IIC = 1;
  35   1          IIC_Delay(DELAY_TIME);
  36   1          SDA_IIC = 0;
  37   1          IIC_Delay(DELAY_TIME);
  38   1          SCL_IIC = 0;  
  39   1      }
  40          
  41          //
  42          void IIC_Stop(void)
  43          {
  44   1          SDA_IIC = 0;
  45   1          SCL_IIC = 1;
  46   1          IIC_Delay(DELAY_TIME);
  47   1          SDA_IIC = 1;
  48   1          IIC_Delay(DELAY_TIME);
  49   1      }
  50          
  51          //
  52          void IIC_SendByte(unsigned char byt)
  53          {
  54   1          unsigned char i;
C51 COMPILER V9.56.0.0   IIC                                                               10/25/2026 21:13:44 PAGE 2   

  55   1      
  56   1          for(i=0; i<8; i++)
  57   1          {
  58   2              SCL_IIC  = 0;
  59   2              IIC_Delay(DELAY_TIME);
  60   2              if(byt & 0x80) SDA_IIC  = 1;
  61   2              else SDA_IIC  = 0;
  62   2              IIC_Delay(DELAY_TIME);
  63   2              SCL_IIC = 1;
  64   2              byt <<= 1;
  65   2              IIC_Delay(DELAY_TIME);
  66   2          }
  67   1          SCL_IIC  = 0;
  68   1      }
  69          
  70          //
  71          unsigned char IIC_RecByte(void)
  72          {
  73   1          unsigned char i, da;
  74   1          for(i=0; i<8; i++)
  75   1          {   
  76   2            SCL_IIC = 1;
  77   2        IIC_Delay(DELAY_TIME);
  78   2        da <<= 1;
  79   2        if(SDA_IIC) da |= 1;
  80   2        SCL_IIC = 0;
  81   2        IIC_Delay(DELAY_TIME);
  82   2          }
  83   1          return da;
  84   1      }
  85          
  86          //
  87          bit IIC_WaitAck(void)
  88          {
  89   1          bit ackbit;
  90   1        
  91   1          SCL_IIC  = 1;
  92   1          IIC_Delay(DELAY_TIME);
  93   1          ackbit = SDA_IIC;
  94   1          SCL_IIC = 0;
  95   1          IIC_Delay(DELAY_TIME);
  96   1          return ackbit;
  97   1      }
  98          
  99          //
 100          void IIC_SendAck(bit ackbit)
 101          {
 102   1          SCL_IIC = 0;
 103   1          SDA_IIC = ackbit;
 104   1          IIC_Delay(DELAY_TIME);
 105   1          SCL_IIC = 1;
 106   1          IIC_Delay(DELAY_TIME);
 107   1          SCL_IIC = 0; 
 108   1          SDA_IIC = 1;
 109   1          IIC_Delay(DELAY_TIME);
 110   1      }
