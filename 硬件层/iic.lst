 112          #ifdef PCF8591_ADC
 113          void PCF8591_Adc(unsigned char* ADC_Value) 
 114          {
 115   1          static unsigned char ADC_Channel;
 116   1          unsigned char temp;
C51 COMPILER V9.56.0.0   IIC                                                               10/25/2026 21:13:44 PAGE 3   

 117   1          switch(ADC_Channel)
 118   1          {
 119   2              case 0: temp = 3;break;
 120   2              case 1: temp = 0;break;
 121   2              case 2: temp = 1;break;
 122   2              case 3: temp = 2;break;
 123   2          }
 124   1          IIC_Start(); 
 125   1          IIC_SendByte(0x90); 
 126   1          IIC_WaitAck(); 
 127   1          IIC_SendByte(0x40+ADC_Channel);
 128   1          IIC_WaitAck(); 
 129   1          IIC_Start(); 
 130   1          IIC_SendByte(0x91); 
 131   1          IIC_WaitAck(); 
 132   1          ADC_Value[temp] = IIC_RecByte(); 
 133   1          IIC_SendAck(1); 
 134   1          IIC_Stop(); 
 135   1          ADC_Channel = ++ADC_Channel % 4;
 136   1      } 
