<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.javatest.mapper.BookMapper">

    <resultMap id="BookResultMap" type="com.example.javatest.entity.Book">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="author" column="author"/>
        <result property="price" column="price"/>
        <result property="stock" column="stock"/>
    </resultMap>

    <select id="findAll" resultMap="BookResultMap">
        SELECT id, title, author, price, stock
        FROM book
    </select>

    <select id="findById" resultMap="BookResultMap">
        SELECT id, title, author, price, stock
        FROM book
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.example.javatest.entity.Book"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book (title, author, price, stock)
        VALUES (#{title}, #{author}, #{price}, #{stock})
    </insert>

    <update id="update" parameterType="com.example.javatest.entity.Book">
        UPDATE book
        SET title = #{title},
        author = #{author},
        price = #{price},
        stock = #{stock}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM book
        WHERE id = #{id}
    </delete>

</mapper>
