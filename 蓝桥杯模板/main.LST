 268   2                  seg[0] = SEG_N;
 269   2                  seg[1] = SEG_DASH;
 270   2                  seg[2] = ne555 >= 10000 ? ne555 / 10000 : SEG_BLANK;
 271   2                  seg[3] = ne555 >= 1000  ? ne555 / 1000 % 10 : SEG_BLANK;
 272   2                  seg[4] = ne555 >= 100   ? ne555 / 100 % 10 : SEG_BLANK;
 273   2                  seg[5] = ne555 >= 10    ? ne555 / 10 % 10 : SEG_BLANK;
 274   2                  seg[6] = ne555 % 10;
 275   2                  seg[7] = SEG_BLANK;
 276   2              break;
 277   2      
 278   2              case 3:               // Ê¾ÀıÒ³Ãæ3£ºÏÔÊ¾³¬Éù²¨¾àÀë
 279   2                  seg[0] = SEG_BLANK;
 280   2                  seg[1] = SEG_BLANK;
 281   2                  seg[2] = SEG_BLANK;
 282   2                  seg[3] = wave >= 1000 ? wave / 1000 : SEG_BLANK;
 283   2                  seg[4] = wave >= 100  ? wave / 100 % 10 : SEG_BLANK;
 284   2                  seg[5] = wave >= 10   ? wave / 10 % 10 : SEG_BLANK;
 285   2                  seg[6] = wave % 10;
 286   2                  seg[7] = SEG_BLANK;
 287   2              break;
 288   2      
 289   2              default:
 290   2                  mode = 0;
 291   2              break;
 292   2          }
 293   1      }
