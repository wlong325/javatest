 201          void HC573_Write(unsigned char channel,unsigned char dat)
 202          {
 203   1          P2 &= 0x1f;
 204   1          P0 = dat;
 205   1          switch(channel)
 206   1          {
 207   2              case 4: P2 = (P2 & 0x1f) | 0x80; break;  // Y4C£ºLED
 208   2              case 5: P2 = (P2 & 0x1f) | 0xa0; break;  // Y5C£º¼ÌµçÆ÷/·äÃùÆ÷
 209   2              case 6: P2 = (P2 & 0x1f) | 0xc0; break;  // Y6C£ºÊıÂë¹ÜÎ»Ñ¡
 210   2              case 7: P2 = (P2 & 0x1f) | 0xe0; break;  // Y7C£ºÊıÂë¹Ü¶ÎÑ¡
 211   2              default: break;
 212   2          }
 213   1          P2 &= 0x1f;
 214   1      }
