 233   1      
 234   1          switch(mode)
 235   1          {
 236   2              case 0:               // Ê¾ÀıÒ³Ãæ0£ºÏÔÊ¾Ê±¼ä HH-MM-SS
 237   2                  seg[0] = rtc[0] / 10;
 238   2                  seg[1] = rtc[0] % 10;
 239   2                  seg[2] = SEG_DASH;
 240   2                  seg[3] = rtc[1] / 10;
 241   2                  seg[4] = rtc[1] % 10;
 242   2                  seg[5] = SEG_DASH;
 243   2                  seg[6] = rtc[2] / 10;
 244   2                  seg[7] = rtc[2] % 10;
 245   2              break;
 246   2      
 247   2              case 1:               // Ê¾ÀıÒ³Ãæ1£ºÏÔÊ¾ÎÂ¶ÈºÍµçÎ»Æ÷µçÑ¹ x.xxV
 248   2                  seg[0] = SEG_BLANK;
 249   2                  if(ds18b20 < 0)
 250   2                  {
 251   3                      seg[1] = SEG_DASH;
 252   3                      seg[2] = (unsigned char)(-ds18b20 / 10);
 253   3                      seg[3] = (unsigned char)(-ds18b20 % 10);
 254   3                  }
 255   2                  else
 256   2                  {
 257   3                      seg[1] = ds18b20 >= 100 ? (unsigned char)(ds18b20 / 100) : SEG_BLANK;
 258   3                      seg[2] = ds18b20 >= 10  ? (unsigned char)(ds18b20 / 10 % 10) : SEG_BLANK;
 259   3                      seg[3] = (unsigned char)(ds18b20 % 10);
 260   3                  }
 261   2                  seg[4] = SEG_DASH;
 262   2                  seg[5] = pot_mv / 1000;
 263   2                  seg[6] = pot_mv / 100 % 10 + 16;
 264   2                  seg[7] = pot_mv / 10 % 10;
